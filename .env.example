# Use "local" for development without Supabase.
# Use "supabase" for real deployment.
VITE_DATA_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public VAPID key used by browsers to subscribe to phone notifications.
# The matching private key belongs only in Supabase Edge Function secrets.
VITE_WEB_PUSH_PUBLIC_KEY=

# Never put a Supabase service role key in a Vite/frontend env file.
